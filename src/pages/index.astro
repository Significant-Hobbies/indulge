---
/*
THESIS: A gentle room assembles as attention moves from an automatic loop toward a chosen life.
OWN-WORLD: Indulge's powder-sky room, navy type, cherry path, soft-form character, and real app captures.
STORY: Name the tension → reveal the trade → show the four-part loop → qualify the fit → prove privacy → invite the beta.
FIRST VIEWPORT: “Enjoy on purpose,” one real Life screen, one promise, one TestFlight action.
FORM: Continuous Life Room panorama. Impeccable seed 6bc4ccc5, assigned structure 6. The room—not a card grid—is the organizing surface.
*/
import SiteLayout from "../layouts/SiteLayout.astro";

const configuredBetaUrl = import.meta.env.PUBLIC_TESTFLIGHT_URL?.trim();
const betaHref = configuredBetaUrl?.startsWith("https://testflight.apple.com/")
  ? configuredBetaUrl
  : "/testflight/";
const hasVerifiedBetaUrl = betaHref !== "/testflight/";
const betaLabel = hasVerifiedBetaUrl ? "Join the TestFlight beta" : "See TestFlight status";

const chapters = [
  { name: "Life", title: "See what you’re making room for.", copy: "Your room becomes a quiet picture of the creativity, movement, people, and rest you want more of.", image: "/images/screens/life.jpg", alt: "Indulge Life screen showing a blue living room assembled around a seated character" },
  { name: "Focus", title: "Find the path back.", copy: "When attention slips, record the interruption and the return—without turning your day into a productivity score.", image: "/images/screens/focus.jpg", alt: "Indulge Focus journal showing a private reflection flow" },
  { name: "Trade", title: "Make one honest trade.", copy: "Keep the pleasure you chose. Reclaim a small pocket of the time that tends to disappear, then give it somewhere to go.", image: "/images/screens/trade.jpg", alt: "Indulge Trade screen showing an intentional time exchange" },
  { name: "History", title: "Notice what changes.", copy: "Look back at the choices and returns that mattered, without streaks, shame, or a scoreboard for your life.", image: "/images/screens/history.jpg", alt: "Indulge History screen showing past attention and recovery entries" }
];
---
<SiteLayout>
  <section class="hero">
    <div class="hero-room" aria-hidden="true">
      <span class="sun"></span>
      <span class="window"></span>
      <span class="shelf"></span>
      <span class="plant"></span>
      <span class="path"></span>
    </div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">Keep the pleasure.</p>
        <h1>Enjoy on<br />purpose.</h1>
        <p class="hero-lede">Trade the time you lose for more of the life you want—gently, privately, and one choice at a time.</p>
        <div class="hero-actions">
          <a class="button" href={betaHref}>{betaLabel} <span aria-hidden="true">{hasVerifiedBetaUrl ? "↗" : "→"}</span></a>
          <a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
        </div>
        <p class="beta-note">Invite-only iPhone testing is underway. No account required.</p>
      </div>
      <figure class="hero-device">
        <div class="phone-shell">
          <img src="/images/screens/life.jpg" width="660" height="1434" alt="The Indulge Life screen, with a character resting in a soft blue room" fetchpriority="high" />
        </div>
        <figcaption>Your Life room changes with the choices you make.</figcaption>
      </figure>
    </div>
  </section>

  <section class="tension shell" aria-labelledby="tension-title">
    <p class="statement">You can enjoy something<br class="wide-only" /> and still want your time back.</p>
    <div class="tension-copy">
      <h2 id="tension-title">No shame. No hard stop.</h2>
      <p>Indulge is for the in-between: when scrolling, watching, gaming, or another pleasure is genuinely welcome—until it runs longer than you meant.</p>
    </div>
  </section>

  <section id="how-it-works" class="chapters" aria-labelledby="chapters-title">
    <div class="shell chapter-intro">
      <div>
        <p class="chapter-kicker">One continuous loop</p>
        <h2 id="chapters-title">A fuller life assembles around you.</h2>
      </div>
      <p>Indulge connects the moment you notice with the thing you want to return to. Four simple spaces hold that story.</p>
    </div>
    <div class="chapter-track">
      <svg class="chapter-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M76,-4 C96,12 82,21 50,28 C13,36 8,46 42,54 C82,64 96,72 64,81 C39,88 34,96 52,104" />
      </svg>
      {chapters.map((chapter, index) => (
        <article class:list={["chapter", index % 2 === 1 && "chapter-reverse"]}>
          <div class="shell chapter-grid">
            <div class="chapter-copy">
              <p class="chapter-name">{chapter.name}</p>
              <h3>{chapter.title}</h3>
              <p>{chapter.copy}</p>
            </div>
            <figure class="screen-frame">
              <img src={chapter.image} width="660" height="1434" loading={index === 0 ? "eager" : "lazy"} decoding="async" alt={chapter.alt} />
            </figure>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="fit-section">
    <div class="shell fit-grid">
      <div>
        <p class="chapter-kicker">A gentle fit</p>
        <h2>Made for reflection.<br />Not restriction.</h2>
      </div>
      <div class="fit-copy">
        <p>Indulge may fit if you want to notice patterns, choose a small trade, and return to something meaningful without blocking apps or chasing a streak.</p>
        <p>It is not medical care, addiction treatment, or Screen Time enforcement. If a habit is causing serious harm, qualified professional support is the right next step.</p>
      </div>
    </div>
  </section>

  <section id="privacy" class="privacy-section" aria-labelledby="privacy-title">
    <div class="shell privacy-grid">
      <div class="privacy-mark" aria-hidden="true">
        <img src="/images/brand/indulge-mark-660.jpg" width="660" height="660" alt="" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="chapter-kicker">Private by default</p>
        <h2 id="privacy-title">Your inner life stays yours.</h2>
        <p>There is no Indulge account, no advertising SDK, no cross-app tracking, and no third-party analytics. Your profile, trades, Focus entries, and history stay in the app’s local container.</p>
        <a class="text-link" href="/privacy/">Read the plain-language privacy policy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="faq shell" aria-labelledby="faq-title">
    <h2 id="faq-title">A few honest answers.</h2>
    <div class="faq-list">
      <details>
        <summary>Does Indulge block apps or use Screen Time?</summary>
        <p>No. This beta does not request Screen Time authorization or enforce limits. It helps you reflect and make an explicit trade.</p>
      </details>
      <details>
        <summary>Do I need an account or internet connection?</summary>
        <p>No account is required, and the core experience works offline. Optional Apple Intelligence features are available only on supported devices.</p>
      </details>
      <details>
        <summary>Where is my data stored?</summary>
        <p>Your profile, trades, Focus notes, and history remain in the app’s local container. TestFlight itself may provide Apple-managed beta diagnostics under Apple’s terms.</p>
      </details>
      <details>
        <summary>Can I join now?</summary>
        <p>We are preparing the invite-only TestFlight beta. Leave the beta page open in your bookmarks; the verified Apple enrollment link will appear there when it is ready.</p>
      </details>
    </div>
  </section>

  <section class="founder-note">
    <div class="shell founder-grid">
      <blockquote>“I wanted a gentler answer than quitting everything or pretending lost time does not matter.”</blockquote>
      <div><p>— Sarthak Agrawal, creator of Indulge</p><p>Indulge is an independent app from Significant Hobbies, built around one belief: pleasure and intention can live in the same room.</p></div>
    </div>
  </section>

  <section class="closing">
    <div class="shell">
      <img src="/images/brand/break-the-loop-lockup.png" width="1536" height="1024" alt="" loading="lazy" />
      <div>
        <h2>Keep what you love.<br />Make room for more.</h2>
        <a class="button" href={betaHref}>{betaLabel} <span aria-hidden="true">{hasVerifiedBetaUrl ? "↗" : "→"}</span></a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { position: relative; min-height: 820px; overflow: hidden; padding: 136px 0 80px; background: var(--blue); }
  .hero-room { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .sun { position: absolute; top: 102px; right: 8%; width: 180px; height: 180px; border-radius: 50%; background: var(--sun); box-shadow: 0 0 90px var(--sun-glow); }
  .window { position: absolute; top: 170px; right: 10%; width: 320px; height: 330px; border: 18px solid var(--window-frame); border-radius: 150px 150px 18px 18px; box-shadow: inset 0 -70px 0 var(--window-tint), 0 20px 60px rgba(12,28,56,.08); }
  .shelf { position: absolute; left: 0; bottom: 165px; width: 34%; height: 18px; border-radius: 0 9px 9px 0; background: rgba(12,28,56,.14); box-shadow: 0 16px 30px rgba(12,28,56,.12); }
  .plant { position: absolute; left: 7%; bottom: 195px; width: 120px; height: 150px; border-radius: 55% 25% 50% 30%; background: var(--leaf); transform: rotate(-12deg); box-shadow: 48px 18px 0 var(--leaf-soft), 24px 100px 0 -34px var(--navy); }
  .path { position: absolute; left: 45%; bottom: -9%; width: 620px; height: 260px; border-radius: 50%; border: 30px solid var(--cherry); border-top-color: transparent; border-left-color: transparent; transform: rotate(-14deg); opacity: .94; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(300px, .78fr); align-items: center; gap: clamp(50px, 8vw, 118px); }
  .hero-copy { padding-top: 30px; }
  .hero-kicker { margin-bottom: 15px; color: var(--cherry-dark); font-family: var(--display); font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 760; }
  h1 { max-width: 8ch; font-size: clamp(4.5rem, 9vw, 7.8rem); line-height: .81; letter-spacing: -.038em; }
  .hero-lede { max-width: 34ch; margin-top: 32px; color: var(--navy-soft); font-size: clamp(1.1rem, 2vw, 1.34rem); line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 25px; margin-top: 32px; }
  .text-link { display: inline-flex; min-height: 44px; gap: 7px; align-items: center; color: var(--navy); font-weight: 750; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .beta-note { margin-top: 14px; color: var(--navy-soft); font-size: .82rem; }
  .hero-device { align-self: end; justify-self: center; width: min(100%, 370px); }
  .phone-shell { overflow: hidden; padding: 8px; border-radius: 50px; background: var(--navy); box-shadow: 0 36px 80px rgba(12,28,56,.26), 0 9px 0 rgba(12,28,56,.1); transform: rotate(2.2deg); }
  .phone-shell img { width: 100%; height: auto; border-radius: 42px; }
  .hero-device figcaption { max-width: 30ch; margin: 18px auto 0; color: var(--navy-soft); font-size: .8rem; text-align: center; }
  .tension { display: grid; grid-template-columns: 1.15fr .65fr; gap: clamp(44px, 9vw, 130px); align-items: end; padding-top: 130px; padding-bottom: 130px; }
  .statement { font-family: var(--display); font-size: clamp(2.7rem, 6vw, 5.7rem); font-weight: 760; line-height: .96; letter-spacing: -.035em; }
  .tension-copy h2 { margin-bottom: 15px; font-size: 1.35rem; }
  .tension-copy p { color: var(--navy-soft); font-size: 1.04rem; line-height: 1.7; }
  .chapters { background: var(--blue); }
  .chapter-intro { display: grid; grid-template-columns: 1fr .58fr; gap: 70px; align-items: end; padding-top: 110px; padding-bottom: 78px; }
  .chapter-kicker { margin-bottom: 15px; color: var(--cherry-dark); font-weight: 780; }
  .chapter-intro h2, .fit-section h2, .privacy-section h2, .closing h2 { font-size: clamp(3rem, 6vw, 5.7rem); line-height: .94; letter-spacing: -.035em; }
  .chapter-intro > p { color: var(--navy-soft); font-size: 1.08rem; line-height: 1.7; }
  .chapter-track { position: relative; overflow: hidden; }
  .chapter-route { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .chapter-route path { fill: none; stroke: var(--cherry); stroke-width: 7; stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: .92; }
  .chapter { position: relative; min-height: 570px; padding: 56px 0; border-top: 1px solid rgba(12,28,56,.1); }
  .chapter-grid { position: relative; z-index: 1; display: grid; grid-template-columns: .8fr 1fr; align-items: center; gap: clamp(48px, 10vw, 150px); }
  .chapter-reverse .chapter-grid { grid-template-columns: 1fr .8fr; }
  .chapter-reverse .chapter-copy { order: 2; }
  .chapter-name { margin-bottom: 18px; color: var(--cherry-dark); font-weight: 780; }
  .chapter-copy h3 { max-width: 10ch; font-size: clamp(2.5rem, 5vw, 4.7rem); line-height: .96; letter-spacing: -.03em; }
  .chapter-copy > p:last-child { max-width: 38ch; margin-top: 22px; color: var(--navy-soft); font-size: 1.05rem; line-height: 1.7; }
  .screen-frame { justify-self: center; width: min(100%, 295px); padding: 7px; border-radius: 42px; background: var(--navy); box-shadow: var(--shadow); transform: rotate(-1.5deg); }
  .chapter-reverse .screen-frame { transform: rotate(1.5deg); }
  .screen-frame img { width: 100%; height: auto; border-radius: 35px; }
  .fit-section { padding: 130px 0; background: var(--paper); }
  .fit-grid { display: grid; grid-template-columns: 1fr .68fr; gap: 80px; }
  .fit-copy p { color: var(--navy-soft); font-size: 1.06rem; line-height: 1.75; }
  .fit-copy p + p { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); }
  .privacy-section { padding: 110px 0; background: var(--navy); color: white; }
  .privacy-grid { display: grid; grid-template-columns: .5fr 1fr; gap: clamp(50px, 11vw, 150px); align-items: center; }
  .privacy-mark { width: min(100%, 330px); padding: 22px; border-radius: 72px; background: var(--blue); box-shadow: 0 30px 80px var(--deep-shadow); transform: rotate(-4deg); }
  .privacy-mark img { border-radius: 52px; }
  .privacy-section .chapter-kicker { color: var(--cherry-light); }
  .privacy-section p:not(.chapter-kicker) { max-width: 48ch; margin-top: 25px; color: var(--navy-light); font-size: 1.08rem; line-height: 1.75; }
  .privacy-section .text-link { margin-top: 28px; color: white; }
  .faq { display: grid; grid-template-columns: .7fr 1fr; gap: clamp(50px, 10vw, 140px); padding-top: 130px; padding-bottom: 130px; }
  .faq h2 { max-width: 8ch; font-size: clamp(3rem, 6vw, 5.6rem); line-height: .94; letter-spacing: -.035em; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 24px 42px 24px 0; font-family: var(--display); font-size: 1.18rem; font-weight: 740; }
  details p { max-width: 62ch; padding: 0 30px 24px 0; color: var(--navy-soft); line-height: 1.7; }
  .founder-note { padding: 110px 0; background: var(--blush); }
  .founder-grid { display: grid; grid-template-columns: 1.1fr .55fr; gap: 80px; align-items: end; }
  blockquote { max-width: 17ch; font-family: var(--display); font-size: clamp(2.5rem, 5vw, 4.8rem); font-weight: 750; line-height: 1; letter-spacing: -.03em; }
  .founder-grid p { color: var(--navy-soft); line-height: 1.75; }
  .founder-grid p + p { margin-top: 18px; }
  .closing { position: relative; overflow: hidden; min-height: 620px; padding: 120px 0; background: var(--blue); }
  .closing::before { content: ""; position: absolute; left: -12%; bottom: -220px; width: 74%; height: 430px; border: 30px solid var(--cherry); border-top-color: transparent; border-radius: 50%; transform: rotate(-8deg); }
  .closing::after { content: ""; position: absolute; top: 74px; right: 8%; width: 170px; height: 170px; border-radius: 50%; background: var(--sun); box-shadow: 0 0 80px var(--sun-glow); }
  .closing .shell { position: relative; z-index: 1; display: grid; grid-template-columns: .65fr 1fr; gap: 70px; align-items: center; }
  .closing img { width: min(100%, 420px); mix-blend-mode: multiply; }
  .closing .button { margin-top: 32px; }
  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-grid { grid-template-columns: 1fr .67fr; gap: 34px; }
    .tension, .chapter-intro, .fit-grid, .faq, .founder-grid { grid-template-columns: 1fr; }
    .tension-copy, .chapter-intro > p, .fit-copy { max-width: 62ch; }
  }
  @media (max-width: 700px) {
    .hero { padding-top: 122px; padding-bottom: 0; }
    .hero-grid { grid-template-columns: 1fr; }
    h1 { font-size: clamp(4.2rem, 22vw, 6rem); }
    .hero-device { justify-self: end; width: min(58%, 205px); margin: 24px clamp(12px, 8vw, 32px) 0 0; }
    .hero-device figcaption { max-width: 24ch; margin-top: 14px; }
    .sun { right: -40px; width: 130px; height: 130px; }
    .window { display: none; }
    .path { left: 9%; bottom: -2%; width: 500px; height: 180px; }
    .tension { padding-top: 90px; padding-bottom: 90px; }
    .wide-only { display: none; }
    .chapter-intro { padding-top: 88px; padding-bottom: 56px; }
    .chapter { min-height: 0; padding: 42px 0; }
    .chapter-grid { grid-template-columns: minmax(0, 1fr) minmax(112px, 34%); gap: clamp(18px, 6vw, 28px); }
    .chapter-reverse .chapter-grid { grid-template-columns: minmax(112px, 34%) minmax(0, 1fr); }
    .chapter-reverse .chapter-copy { order: 2; }
    .chapter-copy h3 { font-size: clamp(2rem, 9vw, 2.7rem); }
    .chapter-copy > p:last-child { margin-top: 16px; font-size: .95rem; line-height: 1.55; }
    .screen-frame { width: 100%; max-width: 150px; }
    .fit-section, .faq { padding-top: 92px; padding-bottom: 92px; }
    .privacy-section { padding: 90px 0; }
    .privacy-grid { grid-template-columns: 1fr; }
    .privacy-mark { width: 160px; border-radius: 40px; padding: 10px; }
    .privacy-mark img { border-radius: 31px; }
    .founder-note { padding: 88px 0; }
    .closing { min-height: 520px; padding: 88px 0; }
    .closing .shell { grid-template-columns: 1fr; }
    .closing img { width: 230px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone-shell, .screen-frame, .chapter-reverse .screen-frame, .privacy-mark { transform: none; }
  }
</style>
